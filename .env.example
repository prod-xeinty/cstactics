# Секреты. Локально — в файл .dev.vars (формат тот же, в git не коммитим; .env.local тоже в .gitignore).
# На сервере — только через `wrangler secret put ИМЯ` и GitHub Actions Secrets. В wrangler.jsonc секреты не кладём.
# База (D1) и видео (R2) — это биндинги из wrangler.jsonc, строк подключения не нужно.
STEAM_API_KEY=
FACEIT_API_KEY=
SESSION_SECRET=
