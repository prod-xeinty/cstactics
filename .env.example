# Секреты. Локально — в файл .dev.vars (формат тот же, в git не коммитим; .env.local тоже в .gitignore).
# На сервере — только через `wrangler secret put ИМЯ` и GitHub Actions Secrets. В wrangler.jsonc секреты не кладём.
# База (D1) и видео (R2) — это биндинги из wrangler.jsonc, строк подключения не нужно.
# Ключ Steam Web API (steamcommunity.com/dev/apikey). Необязателен: без него ник и аватар берём из публичного профиля.
STEAM_API_KEY=
FACEIT_API_KEY=
# Turnstile: секрет из панели Cloudflare. Локально можно тестовый «всегда да»: 1x0000000000000000000000000000000AA
# (site key для него, 1x00000000000000000000AA, — в wrangler.jsonc → vars или флагом --var).
TURNSTILE_SECRET_KEY=
