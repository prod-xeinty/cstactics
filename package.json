{
  "name": "kollgg",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "wrangler types",
    "dev": "next dev",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "preview:vinext": "vite build && wrangler preview --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:seed:local": "wrangler d1 execute DB --local --file=seeds/demo.sql",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "vitest run",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:vinext",
    "audit:deps": "node scripts/audit.mjs",
    "backup:keygen": "node scripts/backup-keygen.mjs",
    "backup:decrypt": "node scripts/backup-decrypt.mjs",
    "backup:selftest": "node scripts/backup-selftest.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@vinext/cloudflare": "1.3.4",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitejs/plugin-rsc": "0.5.39",
    "age-encryption": "0.3.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "wrangler": "4.161.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
