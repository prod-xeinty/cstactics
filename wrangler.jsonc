{
  // Конфиг Cloudflare Workers. Секреты сюда НЕ кладём — только `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kollgg",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kollgg",
      // id базы из `wrangler d1 create kollgg` (не секрет).
      "database_id": "5f401665-fdd7-4199-99d1-5aa8c113203d",
      "migrations_dir": "migrations"
    }
  ],
  // R2 пока не включён (нужна платёжная карта на аккаунте). Раскомментировать, когда дойдём до #12 (загрузка видео),
  // и создать бакеты: `wrangler r2 bucket create kollgg-media-private` / `kollgg-media-public`.
  // "r2_buckets": [
  //   // Видео до модерации (приватный)
  //   { "binding": "MEDIA_PRIVATE", "bucket_name": "kollgg-media-private" },
  //   // Видео после модерации (публичный)
  //   { "binding": "MEDIA_PUBLIC", "bucket_name": "kollgg-media-public" }
  // ],
  // Лимиты запросов (src/platform/rate-limiter-object.ts). Класс экспортируется из worker/index.ts.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiterObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiterObject"] }],
  // Публичные настройки (не секреты). Site key Turnstile — из панели Cloudflare.
  // Пусто = Turnstile выключен (см. docs/security/app-security.md). Secret key — только `wrangler secret put TURNSTILE_SECRET_KEY`.
  "vars": {
    "TURNSTILE_SITE_KEY": ""
  },
  // Логи Workers (бесплатно: 200 000 записей в сутки, хранение 3 дня). Параметры запросов из URL вырезаются:
  // там бывает Steam ID (возврат из Steam). Как смотреть — docs/ops/diagnostics.md.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "invocation_logs": true }
  },
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  }
}
